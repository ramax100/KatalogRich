# Jangan commit file .env.local atau nilai credential asli.

# Kredensial login admin panel (wajib, panel terkunci tanpa ini).
# Ganti dengan kredensial Anda sendiri dan simpan sebagai Sensitive di Vercel.
ADMIN_USERNAME=ganti-dengan-username-admin
ADMIN_PASSWORD=ganti-dengan-password-admin-yang-kuat

# SESSION_SECRET: buat dengan `openssl rand -base64 48`.
SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# BOT_ENCRYPTION_KEY harus Base64 dari tepat 32 byte:
# `openssl rand -base64 32`
BOT_ENCRYPTION_KEY=ganti-dengan-kunci-enkripsi-32-byte-base64

# Server-only Supabase credentials. Jangan gunakan anon key di sini.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-supabase-service-role-key

# Opsional. Direkomendasikan untuk URL webhook yang stabil jika memakai custom domain.
APP_URL=https://nama-app-anda.vercel.app
